# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : jamais exposée au navigateur, utilisée uniquement par
# les routes serveur (crons de facturation/relances). A garder secrète.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (emails transactionnels) — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="LG BOX <contact@lgbox.fr>"

# Secret partagé pour authentifier les appels aux routes /api/cron/*
# (à mettre aussi dans l'en-tête Authorization du Vercel Cron Job).
CRON_SECRET=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application compagnon « Suivi des règlements » (/suivi).
# Mettre à 1 pour forcer le mode démo : l'app tourne alors sur le CSV, sans
# base, et les règlements pointés ne sont pas persistés. Laisser vide en
# production. Sans configuration Supabase, le mode démo s'active de lui-même.
SUIVI_DEMO=
